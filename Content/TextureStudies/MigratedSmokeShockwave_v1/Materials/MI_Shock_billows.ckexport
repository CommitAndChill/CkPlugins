				"props":
				{
					"Code": "float duration=Count/FPS;\nfloat clock=fmod(max(Clock*Speed,0.0),duration+max(Gap,0.0));\nfloat seconds=UseParticleAge>0.5 ? Age*duration : clock;\nfloat frame=Manual>0.5 ? clamp(floor(Frame),0.0,Count-1.0) : min(floor(seconds*FPS+0.0001),Count-1.0);\nfloat alive=Manual>0.5 ? 1.0 : (seconds<duration ? 1.0:0.0);\nfloat2 cell=float2(fmod(frame,Columns),floor(frame/Columns));\nfloat inset=0.5/TilePixels;\nreturn float3((cell+clamp(UV,inset,1.0-inset))/float2(Columns,Rows),alive);"
				}
			},
